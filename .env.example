# Copia a .env y completa. Nunca subas .env al repo.

# ── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Puerto del host (solo 127.0.0.1) que usa docker-compose en producción.
API_PORT=3100

# ── Base de datos ───────────────────────────────────────────────────────────
# Desarrollo local: cualquier Postgres. En docker-compose se arma con las POSTGRES_*.
DATABASE_URL=postgresql://food:food@localhost:5432/food_rutine
POSTGRES_USER=food
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=food_rutine

# ── Sesión ──────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Genera uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Mismo Client ID de Google que el frontend (NEXT_PUBLIC_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# Orígenes del frontend, separados por coma.
CORS_ORIGIN=http://localhost:3000,http://localhost:3100

# Cifra secretos sincronizados (token de Todoist). 32 bytes en base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si cambia, los secretos ya guardados dejan de poder leerse (cada dispositivo los reingresa).
SYNC_SECRETS_KEY=

# ── Web Push ────────────────────────────────────────────────────────────────
# Genera el par: pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@correo.com
